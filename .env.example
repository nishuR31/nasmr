# ─── Database ───────────────────────────────────────────────
DATABASE_URL="postgresql://nasmr:nasmr_secret@localhost:5432/nasmr_db"
DIRECT_URL="postgresql://nasmr:nasmr_secret@localhost:5432/nasmr_db"

# ─── Redis ──────────────────────────────────────────────────
REDIS_URL="redis://default:"

# ─── AI Service ─────────────────────────────────────────────
AI_SERVICE_URL="http://localhost:8000"

# ─── Auth ───────────────────────────────────────────────────
JWT_SECRET="string"
JWT_EXPIRES_IN="7d"

# ─── LLM ────────────────────────────────────────────────────
# Get a free key at https://console.groq.com
GROQ_API_KEY="OPENAI_API_KEY"
# OR use OpenAI:
OPENAI_API_KEY="OPENAI_API_KEY"
LLM_PROVIDER="openai"   # groq | openai | mock

# ─── Maps ───────────────────────────────────────────────────
# MapLibre is free — no key needed for the default style
# If you want Mapbox tiles, add:
# VITE_MAPBOX_TOKEN="pk.xxxxxxxx"

# ─── App ────────────────────────────────────────────────────
NODE_ENV="development"
PORT=3001
VITE_API_URL="http://localhost:3001"
VITE_AI_URL="http://localhost:8000"

# ─── Postgres (Docker) ──────────────────────────────────────
POSTGRES_USER=nasmr
POSTGRES_PASSWORD=nasmr_secret
POSTGRES_DB=nasmr_db
